#!/bin/sh
[ "$1" = configure ] || exit 0

# 1. Permisos de la aplicacion
chown -R root:wheel /Applications/MangaBox.app 2>/dev/null || true
chmod -R 0755 /Applications/MangaBox.app 2>/dev/null || true
chmod 0755 /Applications/MangaBox.app/MangaBox 2>/dev/null || true

# 2. Directorio opcional para comics
mkdir -p /var/mobile/Documents/Comics 2>/dev/null || true
chown -R mobile:mobile /var/mobile/Documents/Comics 2>/dev/null || true
chmod -R 0777 /var/mobile/Documents/Comics 2>/dev/null || true

# 3. Actualizar cache de iconos en iOS
su mobile -c /usr/bin/uicache 2>/dev/null || /usr/bin/uicache 2>/dev/null || true

exit 0
